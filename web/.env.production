# Absolute URL of the deployed API (no trailing slash). If the Render service is ever
# renamed or recreated, update this, API_BASE in wrangler.jsonc and connect-src in public/_headers, then rebuild.
VITE_API_BASE=https://inkwell-zpbc.onrender.com

# The author's main site, for the "About the author" link and the contact line on the privacy page.
# Leave empty until that address loads: while it is empty neither is shown, so no reader is sent to
# a dead link. Once the domain works, set it to https://ahmadnadeem.dev and redeploy.
VITE_PORTFOLIO_URL=
