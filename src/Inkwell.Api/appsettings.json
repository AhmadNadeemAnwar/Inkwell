{
  "ConnectionStrings": {
    "Default": "Data Source=inkwell.db"
  },
  "Jwt": {
    "Issuer": "inkwell",
    "Audience": "inkwell-web",
    "Key": "",
    "ExpiryMinutes": 10080
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*"
}
