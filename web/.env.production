# Absolute URL of the deployed API (no trailing slash). If the Render service is ever
# renamed or recreated, update this and rebuild.
VITE_API_BASE=https://inkwell-zpbc.onrender.com

# Optional bot check on sign-up (Cloudflare Turnstile, free). Leave empty to leave it off.
# Create a widget in the Cloudflare dashboard (Turnstile > Add widget, hostname
# inkwell.ahmadnadeem.dev), put the SITE key here, and the SECRET key in Render as Turnstile__SecretKey.
VITE_TURNSTILE_SITE_KEY=
